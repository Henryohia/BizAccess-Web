<% if (errors.length > 0) { %>
    <div class="notice notice-error" role="alert">
        <p>Please review the following:</p>
        <ul>
            <% errors.forEach((error) => { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form class="user-form" action="<%= action %>" method="POST">
    <div class="form-field">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" value="<%= user.name %>" minlength="2"
            maxlength="100" autocomplete="name" required>
    </div>
    <div class="form-field">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" value="<%= user.email %>" maxlength="254"
            autocomplete="email" required>
    </div>
    <div class="form-field">
        <label for="role">Business role</label>
        <select id="role" name="role" required>
            <option value="">Choose a role</option>
            <% roles.forEach((role) => { %>
                <option value="<%= role %>" <%= user.role === role ? "selected" : "" %>><%= role %></option>
            <% }); %>
        </select>
    </div>
    <button class="button button-primary button-wide" type="submit"><%= submitLabel %></button>
</form>
